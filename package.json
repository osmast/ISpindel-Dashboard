{
  "name": "ispindel-monitor",
  "private": true,
  "description": "Tailwind CSS build step for the dashboard (no JavaScript runtime is used)",
  "scripts": {
    "css": "tailwindcss -i app/assets/input.pcss -o app/assets/tailwind.css --minify",
    "watch": "tailwindcss -i app/assets/input.pcss -o app/assets/tailwind.css --watch --minify"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@toolwind/corner-shape": "^0.0.8-3",
    "tailwindcss": "^4.3.3"
  }
}
