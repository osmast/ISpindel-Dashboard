// iSpindel fermentation monitor - ER diagram including the two dashboard views
// Source of truth: sql/schema.sql (tables + CREATE VIEW v_device_latest / v_experiment_overview).
// Layout: landscape (A4 horizontal, 297 x 210 mm). The tables run left to right in the top
// row, the two views sit side by side (parallel) in the bottom row.
// Render with:
//   dot -Tsvg er_diagram_views.dot -o er_diagram_views.svg
//   dot -Tpng -Gdpi=200 er_diagram_views.dot -o er_diagram_views.png
//
// Solid crow-foot edges = foreign keys (stored data).
// Dashed violet edges   = a view reads these tables (no data of its own).
digraph er_diagram_views {
    // size = A4 landscape in inches (11.69 x 8.27); the drawing is scaled down to fit.
    graph [rankdir=TB, splines=ortho, nodesep=0.40, ranksep=0.70,
           size="11.69,8.27", ratio=compress,
           pad=0.20, bgcolor="white", fontname="Helvetica",
           labelloc="t", fontsize=13,
           label="iSpindel fermentation monitor - schema with the two dashboard views"];
    node  [shape=record, fontname="Helvetica", fontsize=10, penwidth=1.3,
           color="#0057B7", style="rounded,filled"];
    edge  [fontname="Helvetica", fontsize=9, color="#64748B", arrowsize=0.7,
           dir=forward, arrowhead=crow];

    // ---------- tables (stored data) -------------------------------------
    mqtt_broker [label="{mqtt_broker|id : bigint  PK\l|label : text  UNIQUE\l|host : text\l|port : int  CHECK 1..65535\l|username : text\l|password : text\l|topic_prefix : text  DEFAULT 'ispindel'\l|is_enabled : bool  DEFAULT true\l|created_at : timestamptz\l|last_connected_at : timestamptz\l|last_message_at : timestamptz\l|last_error : text\l}", fillcolor="#DBEAFE"];

    device [label="{device|id : bigint  PK\l|broker_id : bigint  FK  (NULL = config.yml)\l|mqtt_name : text\l|display_name : text\l|is_active : bool  DEFAULT true\l|first_seen_at : timestamptz\l|UNIQUE (COALESCE(broker_id,0), mqtt_name)\l}", fillcolor="#FEF3C7"];

    experiment [label="{experiment|id : bigint  PK\l|name : text  UNIQUE  (FR-02)\l|device_id : bigint  FK\l|started_at : timestamptz\l|ended_at : timestamptz  (NULL = active, FR-04)\l|beer_style : text\l|og_plato : numeric(5,2)\l|yeast : text\l|responsible : text\l|notes : text\l|created_at : timestamptz\l|EXCLUDE gist (device_id, tstzrange)  (FR-03/09)\l}", fillcolor="#FEF3C7"];

    measurement [label="{measurement|id : bigint  PK\l|device_id : bigint  FK\l|experiment_id : bigint  FK  (NULL = unassigned, FR-10)\l|recorded_at : timestamptz  (UTC, FR-08)\l|tilt_deg : numeric(5,2)\l|temp_c : numeric(5,2)\l|gravity_plato : numeric(5,2)\l|battery_v : numeric(4,3)\l|interval_s : int\l|rssi_dbm : smallint\l|gravity_raw : numeric(6,4)\l|temp_raw : numeric(6,3)\l|temp_unit : text\l|received_at : timestamptz\l|note : text  (FR-06)\l|UNIQUE (device_id, recorded_at)  (FR-11)\l}", fillcolor="#DBEAFE"];

    experiment_event [label="{experiment_event|id : bigint  PK\l|experiment_id : bigint  FK  ON DELETE CASCADE\l|occurred_at : timestamptz\l|kind : text\l|note : text\l}", fillcolor="#F1F5F9"];

    // ---------- views (no storage, computed on every SELECT) -------------
    // Both views share one rank, so they are drawn parallel in the bottom row.
    v_device_latest [label="{v_device_latest  (VIEW)|device_id : bigint\l|mqtt_name : text\l|recorded_at : timestamptz  (newest)\l|tilt_deg : float8\l|temp_c : float8\l|gravity_plato : float8\l|battery_v : float8\l|interval_s : int\l|rssi_dbm : smallint\l|broker_id : bigint  (NULL = config.yml)\l|broker_label : text\l|DISTINCT ON (device_id) ORDER BY recorded_at DESC\l}", fillcolor="#EDE9FE", color="#7C3AED", style="rounded,filled,dashed"];

    v_experiment_overview [label="{v_experiment_overview  (VIEW)|id : bigint  (experiment.id)\l|name : text\l|ispindel : text  (device.mqtt_name)\l|started_at : timestamptz\l|ended_at : timestamptz\l|is_active : bool  (ended_at IS NULL)\l|measurements : bigint  (count)\l|last_seen_at : timestamptz  (max)\l|beer_style : text\l|og_plato : numeric(5,2)\l|yeast : text\l|responsible : text\l|notes : text\l|broker_id : bigint  (NULL = config.yml)\l|broker_label : text\l|GROUP BY e.id, d.mqtt_name, d.broker_id, b.label\l}", fillcolor="#EDE9FE", color="#7C3AED", style="rounded,filled,dashed"];

    legend [shape=note, style="filled", fillcolor="#F8FAFC", color="#94A3B8", fontsize=9,
            label="Legend\l  solid crow-foot  = foreign key (stored)\l  dashed violet    = view reads the table\l  views hold no data: every SELECT recomputes them\l"];

    // ---------- layout: two wide rows ------------------------------------
    // Top row: the stored tables, left to right in FK order.
    { rank=same; mqtt_broker; device; experiment; measurement; }
    // Bottom row: legend, event log and the two views side by side (parallel).
    { rank=same; legend; experiment_event; v_experiment_overview; v_device_latest; }

    // ---------- foreign keys ---------------------------------------------
    // constraint=false keeps the chain in one row; the rank comes from the rank=same groups.
    mqtt_broker -> device [xlabel="1 : N", constraint=false];
    device -> experiment [xlabel="1 : N", constraint=false];
    experiment -> measurement [xlabel="1 : N", constraint=false];
    experiment -> experiment_event [xlabel="1 : N"];

    // ---------- view dependencies (dashed, no crow-foot) -----------------
    // Two dependencies are left out so the diagram stays readable; the view columns say them:
    //   - the LEFT JOIN on mqtt_broker (column `broker_label`),
    //   - v_device_latest reads `device` (columns `device_id`, `mqtt_name`).
    // Drawing the `device` edge would pull the view to the far left and break the row order.
    edge [style=dashed, color="#7C3AED", arrowhead=vee, dir=forward, penwidth=1.1];

    measurement -> v_device_latest [xlabel="newest row"];

    experiment -> v_experiment_overview [xlabel="1 row per experiment"];
    measurement -> v_experiment_overview [xlabel="count / max"];
}
