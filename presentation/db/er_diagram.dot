// iSpindel fermentation monitor - ER diagram (simple, presentation version)
// Source of truth: sql/schema.sql. Render with:
//   dot -Tsvg er_diagram.dot -o er_diagram.svg
//   dot -Tpng -Gdpi=200 er_diagram.dot -o er_diagram.png
digraph er_diagram {
    graph [rankdir=TB, splines=ortho, nodesep=0.55, ranksep=0.55,
           pad=0.25, bgcolor="white", fontname="Helvetica"];
    node  [shape=record, fontname="Helvetica", fontsize=11, penwidth=1.3,
           color="#0057B7", style="rounded,filled"];
    edge  [fontname="Helvetica", fontsize=9, color="#64748B", arrowsize=0.7,
           dir=forward, arrowhead=crow];

    mqtt_broker [label="{mqtt_broker|id : bigint  PK\l|label : text  UNIQUE\l|host : text\l|port : int\l|is_enabled : bool\l}", fillcolor="#DBEAFE"];
    device [label="{device|id : bigint  PK\l|broker_id : bigint  FK\l|mqtt_name : text\l|display_name : text\l|is_active : bool\l}", fillcolor="#FEF3C7"];
    experiment [label="{experiment|id : bigint  PK\l|name : text  UNIQUE  (FR-02)\l|device_id : bigint  FK\l|started_at : timestamptz\l|ended_at : timestamptz  (NULL = active)\l|beer_style : text\l|og_plato : numeric\l}", fillcolor="#FEF3C7"];
    measurement [label="{measurement|id : bigint  PK\l|device_id : bigint  FK\l|experiment_id : bigint  FK  (NULL = unassigned)\l|recorded_at : timestamptz  (UTC)\l|tilt_deg : numeric\l|temp_c : numeric\l|gravity_plato : numeric\l|battery_v : numeric\l|interval_s : int\l|rssi_dbm : smallint\l}", fillcolor="#DBEAFE"];
    experiment_event [label="{experiment_event|id : bigint  PK\l|experiment_id : bigint  FK\l|occurred_at : timestamptz\l|kind : text\l|note : text\l}", fillcolor="#F1F5F9"];

    // 2 x 2 grid + the event table below the experiment
    { rank=same; mqtt_broker; device; }
    { rank=same; experiment; measurement; }
    { rank=same; experiment_event; }

    mqtt_broker -> device [xlabel="1 : N"];
    device -> experiment [xlabel="1 : N"];
    device -> measurement [xlabel="1 : N"];
    experiment -> measurement [xlabel="1 : N"];
    experiment -> experiment_event [xlabel="1 : N"];
}
