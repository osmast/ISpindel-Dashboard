/* Tailwind source file. Build: cd assets && npm run css (or npm run watch on macOS/Linux).
 * The extension is .pcss on purpose: Dash links every .css file under assets/ automatically,
 * and this file must never be served as a stylesheet.
 */
/* `source(none)` switches automatic source detection off: only classes named in the files listed
 * by `@source` below are compiled, not class names that merely appear in a README or a comment.
 * NB: this stylesheet counts as a source itself, so do not name classes in the comments here. */
@import "tailwindcss" source(none);

/* Loaded from the CSS entry point (Tailwind v4 has no tailwind.config.js). Adds the experimental
 * corner-shape utilities used on every rounded surface; a browser without support ignores it. */
@plugin "@toolwind/corner-shape";

/* Where the class names live (Dash builds the DOM in Python) - the UI files only, not tools/. */
@source "../main.py";
@source "../components/*.py";

/* "The Ultimate Oldschool PC Font Pack v2.2" by VileR (int10h.org), CC BY-SA 4.0 - license text
 * next to the files. The .woff web variants: 1em equals the font's original pixel height. */
@font-face {
  font-family: "IBM XGA-AI 7x15";
  src: url("fonts/Web437_IBM_XGA-AI_7x15.woff") format("woff");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "IBM XGA-AI 12x20";
  src: url("fonts/Web437_IBM_XGA-AI_12x20.woff") format("woff");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "IBM XGA-AI 12x23";
  src: url("fonts/Web437_IBM_XGA-AI_12x23.woff") format("woff");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "IBM XGA-AI 12x20 Plus";
  src: url("fonts/WebPlus_IBM_XGA-AI_12x20.woff") format("woff");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

/* Tailwind theme additions (v4 generates a utility from each entry).
 *
 * fade-in: panels fade in when they appear - on the first page render and whenever a new
 * iSpindel card shows up. dash-renderer gives a component a React key of its `id`
 * (createContainer), so a refresh that re-renders the same card reuses the DOM node and the
 * animation does NOT replay every refresh - only a genuinely new element animates.
 * `motion-reduce:animate-none` (used together with the class) switches it off for users who
 * asked for reduced motion. */
@theme {
  --animate-fade-in: fade-in 0.45s ease-out both;

  /* The page font: the IBM XGA-AI face registered by the @font-face rules above. */
  --font-sans: "IBM XGA-AI 12x20", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;

  /* Brand colours: the yellow page canvas and the blue used for the card outlines. */
  --color-page: #FFDD00;
  --color-brand: #0057B7;

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
}

/* FR-13: the device cards are native <details> accordions, so the browser toggles them instantly.
 * Opening/closing is animated here: the content box grows to its natural height and fades in.
 * An engine without `::details-content` / `interpolate-size` support just opens instantly. */

:root {
  interpolate-size: allow-keywords;
}

details[data-card] {
  --accordion-transition-duration: 0.5s;
}

details[data-card]::details-content {
  block-size: 0;
  opacity: 0;
  overflow-y: clip;
  transition: block-size var(--accordion-transition-duration) ease,
              opacity var(--accordion-transition-duration) ease,
              content-visibility var(--accordion-transition-duration) allow-discrete;
}

details[data-card][open]::details-content {
  block-size: auto;
  opacity: 1;
}

/* the same courtesy as `motion-reduce:animate-none` on the panels: no movement for users who
 * asked for reduced motion */
@media (prefers-reduced-motion: reduce) {
  details[data-card]::details-content {
    transition: none;
  }
}

/* FR-01 / FR-04: the start/end notice is a toast in the top-right corner - it slides in, stays
 * readable for 10 s and fades out. Plain CSS on purpose (not a Tailwind utility). */
@keyframes toast-life {
  0% {
    opacity: 0;
    transform: translateY(-0.5rem);
  }
  4% {
    opacity: 1;
    transform: translateY(0);
  }
  92% {
    opacity: 1;
  }
  100% {
    opacity: 0;
  }
}

.toast-life {
  animation: toast-life 10s ease-out forwards;
}

/* The pointer of the dashboard, in two layers.
 *
 * 1. The static glass cursors: assets/cursor-beer.svg/png (empty glass) and
 *    assets/cursor-beer-hover.svg/png (full glass with a head of foam) - the same glass as the live
 *    one below, at the 32 x 32 size a cursor image wants.
 * 2. The live glass of assets/cursor.js, which follows the mouse and fills up on hover. The script
 *    adds `beer-cursor` to the root element as its **last** step, and that class is what hides the
 *    native pointer - so layer 1 is what a reader without JavaScript or with reduced motion keeps
 *    (and nothing looks half-broken if the script never runs).
 *
 * The raster file comes first in the chain, because only Chromium 122+/Edge understands an SVG
 * cursor while Firefox and Safari fall through to the image and then to the normal pointer. The
 * hotspot 7 7 is the rim of the glass, so a click lands where the drawing points. Everything here
 * is guarded by `pointer: fine` (NFR-06): a touch device has no cursor to restyle. */
@media (pointer: fine) {
  html {
    cursor: url("cursor-beer.png") 7 7, url("cursor-beer.svg") 7 7, auto;
  }

  /* Hover stays in the theme: everything the browser would give a hand cursor gets the filled
   * glass. Plain CSS on purpose - an unlayered rule wins over the `cursor-pointer` utility the
   * Python code puts on the rows - and it is the same set of elements that makes the trail of
   * assets/bubbles.js fizz harder. */
  a,
  button,
  summary,
  label,
  select,
  [role="button"],
  [role="tab"],
  [role="radio"],
  [role="checkbox"],
  [role="switch"],
  .cursor-pointer {
    cursor: url("cursor-beer-hover.png") 7 7, url("cursor-beer-hover.svg") 7 7, pointer;
  }
}

/* The live glass of assets/cursor.js. The root class comes from the script, so this only ever
 * applies while the glass is really there; `cursor: none` on everything is the price of a custom
 * pointer - the text I-beam of the inputs is gone with it, and the glass marks the point instead. */
html.beer-cursor,
html.beer-cursor * {
  cursor: none;
}

.beer-cursor {
  position: fixed;
  top: 0;
  left: 0;
  width: 34px;                 /* keep in sync with SIZE in assets/cursor.js */
  height: 34px;
  z-index: 99999;
  pointer-events: none;
  opacity: 0;                  /* shown with the first pointer movement */
  transition: opacity 0.15s linear;
  transform: translate3d(-100px, -100px, 0);
  will-change: transform;
}

.beer-cursor.is-visible {
  opacity: 1;
}

/* the liquid: a rect as tall as the glass interior, pushed out of sight at the bottom and slid up
 * to the brim while the pointer is over something clickable. A CSS transform rather than the y and
 * height geometry properties of the original design, because those are not supported everywhere. */
.beer-cursor .beer-liquid {
  transform: translateY(26px);
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

.beer-cursor.is-hovering .beer-liquid {
  transform: translateY(0);
}

/* the frothy head, rising over the rim */
.beer-cursor .beer-foam {
  opacity: 0;
  transform: translateY(6px);
  transition: opacity 0.25s ease-out, transform 0.25s ease-out;
}

.beer-cursor.is-hovering .beer-foam {
  opacity: 1;
  transform: translateY(0);
  transition-delay: 0.15s;
}

/* the CO2 rising through the glass - only while it is full */
.beer-cursor .beer-cursor-bubble {
  opacity: 0;
}

.beer-cursor.is-hovering .beer-cursor-bubble {
  animation: cursor-fizz 2.4s linear infinite;
}

.beer-cursor .beer-cursor-bubble:nth-of-type(2) {
  animation-delay: 0.7s;
}

.beer-cursor .beer-cursor-bubble:nth-of-type(3) {
  animation-delay: 1.4s;
}

@keyframes cursor-fizz {
  0% {
    opacity: 0;
    transform: translateY(18px);
  }
  25% {
    opacity: 0.7;
  }
  100% {
    opacity: 0;
    transform: translateY(-8px);
  }
}

/* The bubble trail of assets/bubbles.js: one fixed, click-through layer over the page (below the
 * toast corner, above the content). A bubble has an outer element that rises and pops and an inner
 * one that wobbles sideways and breathes, so the two transforms never fight each other. Only
 * transform and opacity change, so the browser animates them on the compositor. */
.beer-bubbles {
  position: fixed;
  inset: 0;
  z-index: 40;
  overflow: hidden;
  pointer-events: none;
}

.beer-bubble {
  position: fixed;
  transform: translate(-50%, -50%);
  animation: bubble-rise 1200ms ease-out forwards;
  will-change: transform, opacity;
}

/* the CO2 look; the script sets size, wobble speed and the outline of the wilder bubbles inline,
 * so the variety comes from the data, not from a class per size */
.beer-bubble-skin {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%,
              rgb(255 255 255 / 0.92), rgb(255 221 0 / 0.6) 45%, rgb(0 87 183 / 0.32) 100%);
  box-shadow: inset 0 0 0 1px rgb(0 87 183 / 0.35);
  animation: bubble-wobble 600ms ease-in-out infinite alternate;
}

/* the fat white foam bubbles in between, so the trail is not one colour */
.beer-bubble-skin.is-foam {
  background: radial-gradient(circle at 35% 30%,
              rgb(255 255 255 / 0.98), rgb(255 255 255 / 0.55) 50%, rgb(255 221 0 / 0.4) 100%);
}

@keyframes bubble-rise {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.3);
  }
  12% {
    opacity: 1;
  }
  78% {
    opacity: 1;
  }
  92% {
    opacity: 0.85;
    transform: translate(calc(-50% + var(--drift, 0px)),
                         calc(-50% + var(--rise, -80px))) scale(1.12);
  }
  100% {
    opacity: 0;
    transform: translate(calc(-50% + var(--drift, 0px)),
                         calc(-50% + var(--rise, -80px))) scale(1.4);
  }
}

@keyframes bubble-wobble {
  from {
    transform: translateX(-16%) scale(0.94);
  }
  to {
    transform: translateX(16%) scale(1.06);
  }
}

/* second guard next to the test in the script: no trail when motion is reduced (the same courtesy
 * as the accordion and the animate-fade-in panels above) */
@media (prefers-reduced-motion: reduce) {
  .beer-bubbles {
    display: none;
  }
}

