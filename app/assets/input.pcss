/* Tailwind source file.
 *
 * Build (macOS dev):   npm run css      (one-shot, minified -> app/assets/tailwind.css)
 *                      npm run watch    (dev mode: rebuilds on every change, Ctrl-C to stop)
 * Build (Raspberry Pi): use the tailwindcss-linux-arm64 binary, same arguments.
 * The extension is .pcss on purpose: Dash links every .css file inside app/assets/
 * automatically, and this file must never be served as a stylesheet.
 */
/* `source(none)` switches Tailwind's automatic source detection OFF.
 *
 * By default `@import "tailwindcss"` scans the whole project (git-aware) - README.md, docs/,
 * sql/ and every code comment. Any class name *mentioned in prose* is then compiled into the
 * shipped CSS: that is how a background utility and a hover colour, which only ever appeared in
 * a troubleshooting paragraph of the README, ended up in app/assets/tailwind.css although no
 * component uses them - and it is also why the file could only grow. With `source(none)` the
 * compiled CSS contains exactly the classes named below, no more.
 *
 * NB: this stylesheet itself counts as a source, so **do not name classes in comments here
 * either** - write "the background utility" instead of writing the class.
 */
@import "tailwindcss" source(none);

/* `@plugin` is how a Tailwind plugin is loaded in v4 - from the CSS entry point, because there
 * is no tailwind.config.js here. @toolwind/corner-shape adds utilities for the (still
 * experimental) CSS `corner-shape` property: `corner-squircle` and friends, per edge and per
 * corner. The dashboard uses it on every rounded surface, next to the `rounded-*` radius. A
 * browser without support simply ignores the property, so the radius still applies and nothing
 * breaks. Installed by `npm ci` from package.json. */
@plugin "@toolwind/corner-shape";

/* Tell Tailwind where the class names live (Dash builds the DOM in Python).
 * This is the ONLY source: add another line here if a class string ever moves somewhere
 * else (e.g. a .js asset). */
@source "../**/*.py";

/* Fonts: "The Ultimate Oldschool PC Font Pack v2.2" by VileR (int10h.org), licensed CC BY-SA 4.0 -
 * the license text is kept next to the files (app/assets/fonts/LICENSE-oldschool-pc-font-pack.txt).
 * The `Web437` / `WebPlus` .woff files are the web variants: 1em equals the font's original pixel
 * height (7x15 -> 15px, 12x20 -> 20px, 12x23 -> 23px), so a `font-size` and `line-height` at those
 * values give a crisp 1:1 pixel render (whole multiples stay crisp too). Dash serves everything under
 * app/assets/ automatically, so the `fonts/...` URLs below resolve next to the built stylesheet. */
@font-face {
  font-family: "IBM XGA-AI 7x15";
  src: url("fonts/Web437_IBM_XGA-AI_7x15.woff") format("woff");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "IBM XGA-AI 12x20";
  src: url("fonts/Web437_IBM_XGA-AI_12x20.woff") format("woff");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "IBM XGA-AI 12x23";
  src: url("fonts/Web437_IBM_XGA-AI_12x23.woff") format("woff");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "IBM XGA-AI 12x20 Plus";
  src: url("fonts/WebPlus_IBM_XGA-AI_12x20.woff") format("woff");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

/* Tailwind theme additions (v4 generates a utility from each entry).
 *
 * fade-in: panels fade in when they appear - on the first page render and whenever a new
 * iSpindel card shows up. dash-renderer gives a component a React key of its `id`
 * (createContainer), so a refresh that re-renders the same card reuses the DOM node and the
 * animation does NOT replay every refresh - only a genuinely new element animates.
 * `motion-reduce:animate-none` (used together with the class) switches it off for users who
 * asked for reduced motion. */
@theme {
  --animate-fade-in: fade-in 0.45s ease-out both;

  /* The page font: the classic IBM XGA-AI face, registered by the @font-face rules above. This
   * overrides Tailwind's `--font-sans`, which is also the `--default-font-family` Preflight
   * applies to <html>, so the whole UI uses it. Change the first family to switch the look
   * (7x15 = smallest/crispest, 12x23 = largest, "12x20 Plus" = expanded charset). */
  --font-sans: "IBM XGA-AI 12x20", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;

  /* Brand colours (20.10.2026): the yellow page canvas and the blue used for the card outlines.
   * Defined once here instead of a raw hex in each className, so `bg-page` / `border-brand` are
   * the single source. */
  --color-page: #FFDD00;
  --color-brand: #0057B7;

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
}

/* FR-13: the device cards are native <details> accordions (no callback - README 1.9), so the
 * browser hides their content instantly while they are closed. Opening and closing is animated
 * here instead: the content box grows to its natural height and fades in over
 * `--accordion-transition-duration` (0.5 s, declared for the cards right below).
 *
 * Two things make that work:
 *   - `::details-content` is the content box a <details> element gets in a modern engine - the
 *     <summary> (the card header) stays outside it and does not move,
 *   - the height can only animate to `auto` because the `:root` rule turns `interpolate-size`
 *     on; `content-visibility` has to be transitioned with `allow-discrete`, otherwise the
 *     browser would hide the content immediately on closing and nothing would be visible.
 * An engine without either support simply opens the card instantly - nothing breaks. */

:root {
  interpolate-size: allow-keywords;
}

details[data-card] {
  --accordion-transition-duration: 0.5s;
}

details[data-card]::details-content {
  block-size: 0;
  opacity: 0;
  overflow-y: clip;
  transition: block-size var(--accordion-transition-duration) ease,
              opacity var(--accordion-transition-duration) ease,
              content-visibility var(--accordion-transition-duration) allow-discrete;
}

details[data-card][open]::details-content {
  block-size: auto;
  opacity: 1;
}

/* the same courtesy as `motion-reduce:animate-none` on the panels: no movement for users who
 * asked for reduced motion */
@media (prefers-reduced-motion: reduce) {
  details[data-card]::details-content {
    transition: none;
  }
}

/* FR-01 / FR-04: the experiment start/end notice is a toast in the top-right corner. It
 * slides in, stays readable for 10 s and fades out; a clientside callback in main.py then
 * clears the node. Plain CSS on purpose - this is not a Tailwind utility, so it must not
 * depend on the class-name scan. */
@keyframes toast-life {
  0% {
    opacity: 0;
    transform: translateY(-0.5rem);
  }
  4% {
    opacity: 1;
    transform: translateY(0);
  }
  92% {
    opacity: 1;
  }
  100% {
    opacity: 0;
  }
}

.toast-life {
  animation: toast-life 10s ease-out forwards;
}
