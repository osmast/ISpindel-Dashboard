{
  // Terminal -> Run Task (or Ctrl/Cmd+Shift+B for the default build task).
  //
  // The compiled CSS is an ARTEFACT: Tailwind runs once and Dash then serves
  // assets/tailwind.css statically - there is no JIT in the browser. A class that is
  // added to main.py / components/*.py therefore does nothing until the CSS is rebuilt.
  //
  //   Tailwind: build   one-shot, minified  -> commit/deploy this result
  //   Tailwind: watch   dev mode: rebuilds on every change; Ctrl-C stops it
  //
  // `watch` writes the same minified file as `build`, so run `watch` while editing, Ctrl-C, then
  // `build` before committing. `npm run css` in a terminal does exactly the same.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Tailwind: build",
      "detail": "cd assets && npm run css - rebuild assets/tailwind.css (minified)",
      "type": "shell",
      "command": "npm run css",
      "options": {
        "cwd": "${workspaceFolder}/assets"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Tailwind: watch",
      "detail": "cd assets && npm run watch - dev mode, rebuilds on every change (Ctrl-C stops it)",
      "type": "shell",
      "command": "npm run watch",
      "options": {
        "cwd": "${workspaceFolder}/assets"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
